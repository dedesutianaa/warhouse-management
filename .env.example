# Database
DATABASE_URL="postgresql://user:password@localhost:5432/wms"

# NextAuth
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Security
ENCRYPTION_KEY="your-32-char-encryption-key-here"
JWT_SECRET="your-jwt-secret-key"

# Rate Limiting
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW_MS="900000"

# Email (for notifications)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@gudangku.id"
SMTP_PASSWORD="your-smtp-password"
EMAIL_FROM="noreply@gudangku.id"

# SMS/WhatsApp (for notifications)
WHATSAPP_API_KEY="your-whatsapp-api-key"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"

# External Integrations
SAP_B1_URL="https://your-sap-b1.example.com"
SAP_B1_CLIENT_ID="your-client-id"
SAP_B1_CLIENT_SECRET="your-client-secret"

SHOPEE_APP_ID="your-shopee-app-id"
SHOPEE_APP_SECRET="your-shopee-app-secret"

TOKOPEDIA_CLIENT_ID="your-tokopedia-client-id"
TOKOPEDIA_CLIENT_SECRET="your-tokopedia-client-secret"

TIKTOK_SHOP_APP_KEY="your-tiktok-app-key"
TIKTOK_SHOP_APP_SECRET="your-tiktok-app-secret"

LAZADA_APP_KEY="your-lazada-app-key"
LAZADA_APP_SECRET="your-lazada-app-secret"

JNE_API_KEY="your-jne-api-key"
JNE_API_SECRET="your-jne-api-secret"

JNT_API_KEY="your-jnt-api-key"
JNT_API_SECRET="your-jnt-api-secret"

SICEPAT_API_KEY="your-sicepat-api-key"
SICEPAT_API_SECRET="your-sicepat-api-secret"

# Feature Flags
ENABLE_MOBILE_PWA="true"
ENABLE_OFFLINE_MODE="true"
ENABLE_REAL_TIME_UPDATES="true"

# Monitoring
SENTRY_DSN="your-sentry-dsn"
LOG_LEVEL="info"