generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum InventoryStatus {
  AVAILABLE
  ALLOCATED
  PICKED
  PACKED
  IN_TRANSIT
  QUARANTINE
  HOLD
  DAMAGED
  EXPIRED
  BLOCKED
}

enum TaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum TaskType {
  RECEIVE
  PUTAWAY
  PICK
  REPLENISH
  MOVE
  COUNT
  PACK
  QC
  RETURN_INSPECTION
  SHIPPING
}

enum OrderStatus {
  DRAFT
  CREATED
  ALLOCATED
  BACKORDER
  SHORT
  RELEASED
  PICKING
  PICKED
  PACKING
  PACKED
  STAGED
  SHIPPED
  DELIVERED
  ON_HOLD
  CANCELLED
}

enum InboundStatus {
  EXPECTED
  SCHEDULED
  ARRIVED
  RECEIVING
  QC
  PUTAWAY
  COMPLETED
  CANCELLED
}

enum WaveStatus {
  DRAFT
  RELEASED
  PICKING
  COMPLETED
  CANCELLED
}

enum AllocationStrategy {
  FIFO
  FEFO
  LIFO
  LOT_SPECIFIC
}

enum AdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReturnStatus {
  RMA_CREATED
  RECEIVED
  INSPECTION
  DISPOSITION_PENDING
  RESTOCKED
  REFURBISH
  QUARANTINE
  SCRAPPED
  RTV
  COMPLETED
}

enum ReturnGrade {
  A
  B
  C
  DAMAGED
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  COMPLETED
  CANCELLED
}

enum QCStatus {
  PENDING
  IN_PROGRESS
  PASSED
  FAILED
  HOLD
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  SYNCING
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  WHATSAPP
  SLACK
  TEAMS
}

enum DocumentType {
  GRN
  PACKING_LIST
  INVOICE
  DELIVERY_NOTE
  MANIFEST
  LABEL
  BARCODE
}

model Tenant {
  id            String       @id @default(cuid())
  name          String
  code          String       @unique
  domain        String?
  settings      Json         @default("{}")
  features      Json         @default("{}")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  users         User[]
  warehouses    Warehouse[]
  items         Item[]
  partners      Partner[]
  locations     Location[]
  inboundOrders InboundOrder[]
  outboundOrders OutboundOrder[]
  inventory     Inventory[]
  transactions  InventoryTransaction[]
  tasks         Task[]
  waves         Wave[]
  returns       Return[]
  transfers     Transfer[]
  adjustments   Adjustment[]
  cycleCounts   CycleCount[]
  qcInspections QCInspection[]
  integrations  Integration[]
  webhooks      Webhook[]
  auditLogs     AuditLog[]
  notifications Notification[]
  documentTemplates DocumentTemplate[]
  featureFlags  FeatureFlag[]
  rateCards     RateCard[]
  invoices      Invoice[]
}

model User {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  email         String
  passwordHash  String
  name          String
  phone         String?
  avatar        String?
  roleId        String
  role          Role         @relation(fields: [roleId], references: [id])
  warehouseId   String?
  warehouse     Warehouse?   @relation(fields: [warehouseId], references: [id])
  status        UserStatus   @default(ACTIVE)
  mfaEnabled    Boolean      @default(false)
  mfaSecret     String?
  lastLoginAt   DateTime?
  lockedAt      DateTime?
  failedAttempts Int         @default(0)
  preferences   Json         @default("{}")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  assignedTasks Task[]       @relation("AssignedTasks")
  createdTasks  Task[]       @relation("CreatedTasks")
  transactions  InventoryTransaction[]
  adjustments   Adjustment[] @relation("AdjustmentRequester")
  approvedAdjustments Adjustment[] @relation("AdjustmentApprover")
  cycleCounts   CycleCount[] @relation("CycleCountAssignee")
  qcInspections QCInspection[] @relation("QCInspector")
  returns       Return[]     @relation("ReturnAssignee")
  auditLogs     AuditLog[]
  sessions      Session[]
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([warehouseId])
  @@index([roleId])
}

model Role {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  permissions Json         @default("[]")
  isSystem    Boolean      @default(false)
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  category    String
  createdAt   DateTime @default(now())
}

model Warehouse {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  code        String
  name        String
  address     String?
  city        String?
  country     String       @default("Indonesia")
  timezone    String       @default("Asia/Jakarta")
  isActive    Boolean      @default(true)
  settings    Json         @default("{}")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  zones       Zone[]
  locations   Location[]
  users       User[]
  inboundOrders InboundOrder[]
  outboundOrders OutboundOrder[]
  inventory   Inventory[]
  tasks       Task[]
  waves       Wave[]
  transfersFrom Transfer[] @relation("FromWarehouse")
  transfersTo   Transfer[] @relation("ToWarehouse")
  @@unique([tenantId, code])
  @@index([tenantId])
}

model Zone {
  id            String       @id @default(cuid())
  warehouseId   String
  warehouse     Warehouse    @relation(fields: [warehouseId], references: [id])
  code          String
  name          String
  type          String       @default("storage")
  temperature   String?
  description   String?
  isActive      Boolean      @default(true)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  aisles        Aisle[]
  locations     Location[]
  @@unique([warehouseId, code])
  @@index([warehouseId])
}

model Aisle {
  id          String   @id @default(cuid())
  zoneId      String
  zone        Zone     @relation(fields: [zoneId], references: [id])
  code        String
  name        String?
  startCoord  String?
  endCoord    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  racks       Rack[]
  @@unique([zoneId, code])
  @@index([zoneId])
}

model Rack {
  id          String   @id @default(cuid())
  aisleId     String
  aisle       Aisle    @relation(fields: [aisleId], references: [id])
  code        String
  name        String?
  levels      Int      @default(1)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  levels_     Level[]
  @@unique([aisleId, code])
  @@index([aisleId])
}

model Level {
  id          String   @id @default(cuid())
  rackId      String
  rack        Rack     @relation(fields: [rackId], references: [id])
  code        String
  name        String?
  height      Decimal?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bins        Bin[]
  @@unique([rackId, code])
  @@index([rackId])
}

model Bin {
  id              String           @id @default(cuid())
  levelId         String
  level           Level            @relation(fields: [levelId], references: [id])
  code            String
  name            String?
  locationId      String?          @unique
  location        Location?        @relation(fields: [locationId], references: [id])
  isActive        Boolean          @default(true)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  @@unique([levelId, code])
  @@index([levelId])
}

model Location {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  warehouseId     String
  warehouse       Warehouse        @relation(fields: [warehouseId], references: [id])
  zoneId          String?
  zone            Zone?            @relation(fields: [zoneId], references: [id])
  code            String
  name            String?
  type            String
  status          String           @default("active")
  capacityWeight  Decimal?
  capacityVolume  Decimal?
  capacityPallets Int?
  maxWeight       Decimal?
  maxVolume       Decimal?
  dimensions      Json?
  temperatureZone String?
  locationClass   String           @default("B")
  restrictions    Json             @default("[]")
  coordinates     Json?
  pickSequence    Int?
  putawaySequence Int?
  parentId        String?
  parent          Location?        @relation("LocationHierarchy", fields: [parentId], references: [id])
  children        Location[]       @relation("LocationHierarchy")
  inventories     Inventory[]
  lpnLocations    LPNLocation[]
  putawayRules    PutawayRule[]
  replenRules     ReplenishmentRule[]
  countLocations  CycleCountLocation[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  @@unique([warehouseId, code])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([warehouseId])
  @@index([zoneId])
  @@index([type])
  @@index([status])
}

model LocationType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Item {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  sku             String
  name            String
  description     String?
  categoryId      String?
  category        ItemCategory? @relation(fields: [categoryId], references: [id])
  brandId         String?
  brand           Brand?       @relation(fields: [brandId], references: [id])
  baseUomId       String
  baseUom         UoM          @relation("BaseUoM", fields: [baseUomId], references: [id])
  purchaseUomId   String?
  purchaseUom     UoM?         @relation("PurchaseUoM", fields: [purchaseUomId], references: [id])
  salesUomId      String?
  salesUom        UoM?         @relation("SalesUom", fields: [salesUomId], references: [id])
  weight          Decimal?
  volume          Decimal?
  dimensions      Json?
  imageUrl        String?
  hasLot          Boolean      @default(false)
  hasSerial       Boolean      @default(false)
  hasExpiry       Boolean      @default(false)
  shelfLifeDays   Int?
  minShelfLifePct Int?
  storageTempMin  Decimal?
  storageTempMax  Decimal?
  isHazmat        Boolean      @default(false)
  isFragile       Boolean      @default(false)
  isActive        Boolean      @default(true)
  abcClass        String       @default("C")
  xyzClass        String       @default("Z")
  velocity        String       @default("slow")
  putawayRuleId   String?
  putawayRule     PutawayRule? @relation(fields: [putawayRuleId], references: [id])
  pickingRuleId   String?
  pickingRule     PickingRule? @relation(fields: [pickingRuleId], references: [id])
  replenRuleId    String?
  replenRule      ReplenishmentRule? @relation(fields: [replenRuleId], references: [id])
  allocationRuleId String?
  allocationRule  AllocationRule? @relation(fields: [allocationRuleId], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  barcodes        Barcode[]
  uoms            ItemUoM[]
  variants        ItemVariant[] @relation("ParentItem")
  parentVariant   ItemVariant? @relation("ParentItem", fields: [parentId], references: [id])
  boms            BOM[]        @relation("BOMParent")
  components      BOM[]        @relation("BOMComponent")
  inventory       Inventory[]
  transactions    InventoryTransaction[]
  allocations     Allocation[]
  pickTasks       PickTask[]
  packTasks       PackTask[]
  returns         Return[]
  adjustments     Adjustment[]
  cycleCountItems CycleCountItem[]
  qcItems         QCItem[]
  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
  @@index([abcClass])
}

model ItemCategory {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  code        String
  name        String
  parentId    String?
  parent      ItemCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    ItemCategory[] @relation("CategoryHierarchy")
  isActive    Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       Item[]
  @@unique([tenantId, code])
  @@index([tenantId])
}

model Brand {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       Item[]
  @@unique([tenantId, code])
  @@index([tenantId])
}

model UoM {
  id              String     @id @default(cuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id])
  code            String
  name            String
  type            String
  baseUomId       String?
  baseUom         UoM?       @relation("UoMHierarchy", fields: [baseUomId], references: [id])
  conversions     UoMConversion[] @relation("UoMConversion")
  itemsBase       Item[]     @relation("BaseUoM")
  itemsPurchase   Item[]     @relation("PurchaseUoM")
  itemsSales      Item[]     @relation("SalesUom")
  itemUoms        ItemUoM[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  @@unique([tenantId, code])
  @@index([tenantId])
}

model UoMConversion {
  id            String   @id @default(cuid())
  fromUomId     String
  fromUom       UoM      @relation("UoMConversion", fields: [fromUomId], references: [id])
  toUomId       String
  toUom         UoM      @relation("UoMConversion", fields: [toUomId], references: [id])
  factor        Decimal
  createdAt     DateTime @default(now())
  @@unique([fromUomId, toUomId])
}

model ItemUoM {
  id            String   @id @default(cuid())
  itemId        String
  item          Item     @relation(fields: [itemId], references: [id])
  uomId         String
  uom           UoM      @relation(fields: [uomId], references: [id])
  conversion    Decimal  @default(1)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  @@unique([itemId, uomId])
  @@index([itemId])
}

model Barcode {
  id          String   @id @default(cuid())
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id])
  code        String
  type        String   @default("EAN13")
  uomId       String?
  uom         UoM?     @relation(fields: [uomId], references: [id])
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  @@unique([itemId, code])
  @@index([itemId])
  @@index([code])
}

model ItemVariant {
  id          String   @id @default(cuid())
  parentId    String
  parent      Item     @relation("ParentItem", fields: [parentId], references: [id])
  sku         String
  name        String
  attributes  Json     @default("{}")
  barcodes    Barcode[]
  inventory   Inventory[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([parentId, sku])
  @@index([parentId])
}

model BOM {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  parentId        String
  parent          Item     @relation("BOMParent", fields: [parentId], references: [id])
  componentId     String
  component       Item     @relation("BOMComponent", fields: [componentId], references: [id])
  quantity        Decimal
  uomId           String
  uom             UoM      @relation(fields: [uomId], references: [id])
  sequence        Int      @default(0)
  isOptional      Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([tenantId, parentId, componentId])
  @@index([tenantId])
  @@index([parentId])
  @@index([componentId])
}

model Partner {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  code            String
  name            String
  type            String
  contactName     String?
  email           String?
  phone           String?
  address         String?
  city            String?
  country         String?
  taxId           String?
  paymentTerms    Int?
  currency        String       @default("IDR")
  rating          Decimal?
  isActive        Boolean      @default(true)
  metadata        Json         @default("{}")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  inboundOrders   InboundOrder[] @relation("InboundSupplier")
  outboundOrders  OutboundOrder[] @relation("OutboundCustomer")
  returns         Return[]     @relation("ReturnCustomer")
  carrierOrders   OutboundOrder[] @relation("OutboundCarrier")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([type])
}

model ReasonCode {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  code        String
  label       String
  category    String
  description String?
  isActive    Boolean  @default(true)
  requiresApproval Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  adjustments Adjustment[]
  returns     Return[]
  qcItems     QCItem[]
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([category])
}

model PutawayRule {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  name            String
  description     String?
  priority        Int      @default(0)
  conditions      Json     @default("{}")
  targetZoneId    String?
  targetZone      Zone?    @relation(fields: [targetZoneId], references: [id])
  targetClass     String?
  consolidate     Boolean  @default(true)
  fefo            Boolean  @default(true)
  singleLot       Boolean  @default(false)
  singleSku       Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           Item[]
  locations       Location[]
  @@index([tenantId])
}

model PickingRule {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  name            String
  strategy        AllocationStrategy @default(FEFO)
  description     String?
  priority        Int      @default(0)
  conditions      Json     @default("{}")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           Item[]
  @@index([tenantId])
}

model ReplenishmentRule {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  name            String
  description     String?
  minQty          Decimal
  maxQty          Decimal
  triggerQty      Decimal?
  sourceZoneId    String?
  sourceZone      Zone?    @relation(fields: [sourceZoneId], references: [id])
  targetZoneId    String?
  targetZone      Zone?    @relation(fields: [targetZoneId], references: [id])
  priority        Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           Item[]
  locations       Location[]
  @@index([tenantId])
}

model AllocationRule {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  name            String
  strategy        AllocationStrategy @default(FEFO)
  description     String?
  priority        Int      @default(0)
  conditions      Json     @default("{}")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           Item[]
  @@index([tenantId])
}

model InboundOrder {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  warehouseId     String
  warehouse       Warehouse    @relation(fields: [warehouseId], references: [id])
  supplierId      String
  supplier        Partner      @relation("InboundSupplier", fields: [supplierId], references: [id])
  referenceType   String
  referenceId     String
  referenceNumber String
  status          InboundStatus @default(EXPECTED)
  expectedDate    DateTime?
  arrivalDate     DateTime?
  dockId          String?
  dock            Location?    @relation(fields: [dockId], references: [id])
  assignedToId    String?
  assignedTo      User?        @relation(fields: [assignedToId], references: [id])
  notes           String?
  metadata        Json         @default("{}")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  lines           InboundLine[]
  receipts        Receipt[]
  qcInspections   QCInspection[]
  putawayTasks    Task[]
  @@index([tenantId])
  @@index([warehouseId])
  @@index([supplierId])
  @@index([status])
  @@index([expectedDate])
}

model InboundLine {
  id              String   @id @default(cuid())
  inboundOrderId  String
  inboundOrder    InboundOrder @relation(fields: [inboundOrderId], references: [id])
  itemId          String
  item            Item     @relation(fields: [itemId], references: [id])
  expectedQty     Decimal
  receivedQty     Decimal  @default(0)
  uomId           String
  uom             UoM      @relation(fields: [uomId], references: [id])
  lot             String?
  expiryDate      DateTime?
  serialNumbers   Json     @default("[]")
  status          String   @default("pending")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  receiptLines    ReceiptLine[]
  @@index([inboundOrderId])
  @@index([itemId])
}

model Receipt {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  inboundOrderId  String
  inboundOrder    InboundOrder @relation(fields: [inboundOrderId], references: [id])
  grnNumber       String   @unique
  receivedAt      DateTime @default(now())
  receivedById    String
  receivedBy      User     @relation(fields: [receivedById], references: [id])
  dockId          String?
  dock            Location? @relation(fields: [dockId], references: [id])
  status          String   @default("completed")
  notes           String?
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lines           ReceiptLine[]
  lpnCreated      LPN[]
  @@index([tenantId])
  @@index([inboundOrderId])
  @@index([grnNumber])
}

model ReceiptLine {
  id              String   @id @default(cuid())
  receiptId       String
  receipt         Receipt  @relation(fields: [receiptId], references: [id])
  inboundLineId   String?
  inboundLine     InboundLine? @relation(fields: [inboundLineId], references: [id])
  itemId          String
  item            Item     @relation(fields: [itemId], references: [id])
  expectedQty     Decimal
  receivedQty     Decimal
  uomId           String
  uom             UoM      @relation(fields: [uomId], references: [id])
  lot             String?
  expiryDate      DateTime?
  serialNumbers   Json     @default("[]")
  status          String   @default("received")
  discrepancyQty  Decimal  @default(0)
  discrepancyReason String?
  photos          Json     @default("[]")
  lpnId           String?
